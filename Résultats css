:root {
    --noir: #151a20;
    --turquoise: #27d9c5;
    --turquoise-fonce: #159e91;
    --fond: #f5f7f8;
    --blanc: #ffffff;
    --texte: #46515b;
    --texte-secondaire: #7b8790;
    --bordure: #e1e7e9;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f5f5f5;
    background: var(--fond);
    color: var(--noir);
    line-height: 1.7;
}

.header {
    width: 100%;
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 12px 4%;

    background: #151a20;
    color: #f4f5f6;
    border-bottom: 2px solid #3b444d;
}


.brand {
    flex-shrink: 0;
    min-width: 245px;
}

.brand h1 {
    font-size: 23px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.5px;
}

.brand p {
    margin-top: 3px;
    font-size: 15px;
    color: #d0d4da;
}

.navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 3.5vw, 46px);
    height: 100%;
}

.nav-link {
    position: relative;
    display: flex;
    align-items: center;
    height: 56px;

    color: #d5d7db;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    transition: color 0.2s ease;
}

.nav-link:hover {
    color: #ffffff;
}

.nav-link.active {
    color: #ffffff;
}

.nav-link.active::after {
    content: "";
    position: absolute;
    bottom: 5px;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: #27d9c5;
}

.about {
    display: flex;
    align-items: center;
    gap: 11px;
    flex-shrink: 0;

    color: #d5d7db;
    text-decoration: none;
    font-size: 12px;
    white-space: nowrap;
}

.about:hover {
    color: #ffffff;
}

.info-icon {
    display: inline-flex;
    justify-content: center;
    align-items: center;

    width: 15px;
    height: 15px;
    border: 2px solid #929aa4;
    border-radius: 50%;

    color: #c5cbd2;
    font-size: 10px;
    font-weight: bold;
}
